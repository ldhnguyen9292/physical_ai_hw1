# =============================================================================
# EXPERIMENT DECLARATION — floor1_baseline   (scaffolded by `api.py declare`)
#
# This file is YOURS until `reconstruct.py` seals it: edit the label, trim
# add setting overrides. After assessment the student section is
# digest-sealed — a new idea is a NEW file under a NEW name (§3.1).
#
# PREDICTION (write BEFORE assessing — the seal makes it non-retractable):
#   pipeline: expect RawPointCount to drop on frames with missing depth, and
#             ICPInlierFitness / CoarseRANSACFitness to drop on pairs with
#             large motion or sparse geometry (low VoxelizedPointYield).
#   baseline: expect mapMeanL2 around 0.1-0.2 m; trajectory follows GT but
#             drifts after the degraded segments.
# =============================================================================

@prefix hw1:  <http://taica.course/hw1/ontology#> .
@prefix batch: <http://taica.course/hw1/data/batch/> .
@prefix data:  <http://taica.course/hw1/data/> .
@prefix exp:   <http://taica.course/hw1/experiment/> .
@prefix factor: <http://taica.course/hw1/experiment/floor1_baseline/factor/> .
@prefix run: <http://taica.course/hw1/experiment/floor1_baseline/run/> .
@prefix setting: <http://taica.course/hw1/experiment/floor1_baseline/setting/> .
@prefix frame: <http://taica.course/hw1/data/batch/floor1_first_floor/frame/> .
@prefix rgb: <http://taica.course/hw1/data/batch/floor1_first_floor/rgb/> .
@prefix depth: <http://taica.course/hw1/data/batch/floor1_first_floor/depth/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

exp:floor1_baseline
    a hw1:Experiment ;
    hw1:schemaVersion "7.0.0" ;
    rdfs:label "Floor 1 full-batch baseline, open3d point-to-plane ICP, voxel 0.05 m"@en ;
    hw1:batchFile "eval/first_floor" ;
    hw1:onBatch batch:floor1_first_floor .   # floor1_first_floor

# All pipeline-derived factors are recorded automatically during reconstruction.
#
# OVERRIDES — every setting you do not declare is filled from its TBox default
# at assessment time (preview with `explore` before committing). To override
# one, replace the final "." above with ";" and append a blank node, e.g.:
#
#     hw1:hasFactorSetting [
#         a hw1:FactorSetting ;
#         hw1:settingParameter hw1:icpBackend ;
#         hw1:settingRole hw1:ReconstructionSetting ;
#         hw1:settingForFactor hw1:ReconstructionRun ;
#         hw1:settingValue "my_icp"^^xsd:string
#     ] .
#
# hw1:settingRole must match the parameter's TBox hw1:paramRole.
